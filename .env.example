# PayPhone Engine — environment template
# Copy to .env, fill in, NEVER commit real values.

# ── Runtime mode ──────────────────────────────────────────────────────────
# PAYPHONE_ENV=production → fail-closed: refuses to boot without real keys,
# SimNet off by default. Leave unset for development.
PAYPHONE_ENV=

# ── Core secrets (generate: openssl rand -hex 32) ─────────────────────────
PAYPHONE_MASTER_KEY=           # root of all merchant key derivation → KMS in prod
PAYPHONE_SIGNING_KEY=          # invoice token + webhook signatures
PAYPHONE_PHONE_PEPPER=         # phone-hash privacy

# ── Networks ──────────────────────────────────────────────────────────────
PAYPHONE_SIMNET=1              # 0 in production
# All five real mainnets are enabled by DEFAULT on public RPC endpoints.
# Override per network for production volume (indexed providers):
EVM_RPC_ETHEREUM=              # default: https://ethereum-rpc.publicnode.com
EVM_RPC_BASE=                  # default: https://mainnet.base.org
EVM_RPC_ARBITRUM=              # default: https://arb1.arbitrum.io/rpc
EVM_RPC_POLYGON=               # default: https://polygon-bor-rpc.publicnode.com
EVM_RPC_OPTIMISM=              # default: https://mainnet.optimism.io
EVM_RPC_BSC=                   # default: https://bsc-rpc.publicnode.com
EVM_RPC_AVALANCHE=             # default: https://avalanche-c-chain-rpc.publicnode.com

# Non-EVM watch-only chains (all real mainnets, enabled by default):
BTC_API_BASE=                  # Esplora API, default: https://blockstream.info/api
SOL_RPC_URL=                   # default: https://api.mainnet-beta.solana.com
TRON_API_BASE=                 # default: https://api.trongrid.io

# ── Services ──────────────────────────────────────────────────────────────
PAYPHONE_PORT=8080
PAYPHONE_ORACLE_URL=http://127.0.0.1:8001
PAYPHONE_CHECKOUT_URL=         # public origin for payment links, e.g. https://pay.yourdomain.com
PAYPHONE_CORS_ORIGINS=*        # lock down in production

# ── Limits ────────────────────────────────────────────────────────────────
PAYPHONE_RATE_LIMIT_PER_MIN=240
PAYPHONE_REPLAY_WINDOW=300
PAYPHONE_INVOICE_TTL=900
PAYPHONE_ADMIN_TOKEN=          # gates POST /v1/keys in production
PAYPHONE_REVOKED_KEYS=         # comma-separated key_ids (config-level revocation)

# ── Revenue ───────────────────────────────────────────────────────────────
PAYPHONE_TREASURY_ADDRESS=     # YOUR wallet: receives the 60% protocol fee share.
                               # Named on every invoice + checkout; published by
                               # GET /v1/fees/schedule. Use an address valid on the
                               # settlement chains (EVM 0x… for the EVM networks).
